# ==============================================================================
# Canteen Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' if your deployment pipeline uses environment variables.
# NEVER commit the actual '.env' file containing production credentials to GitHub!

# Application Environment
APP_NAME="Canteen Management System"
APP_ENV=development          # Options: development, staging, production
APP_DEBUG=true               # Set to false in production
APP_URL=http://localhost/canteen
APP_TIMEZONE=Asia/Kolkata

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=canteen_db
DB_USERNAME=root
DB_PASSWORD=

# Brevo (Sendinblue) SMTP / Transactional Mailer Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_login@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-your-brevo-api-key-here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@canteen.local
MAIL_FROM_NAME="Canteen System"

# Session & Security Settings
SESSION_LIFETIME=1440        # In minutes (24 hours)
T_PIN_LENGTH=4               # Required length for member and manager authorization PIN
