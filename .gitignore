# ==============================================================================
# Git Ignore Configuration - Canteen Management System
# ==============================================================================
# Senior Developer Best Practice: Keep all API keys, database credentials,
# environment files, sensitive database dumps, logs, and OS caches out of git.

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Configuration Files (API Keys & Credentials)
# ------------------------------------------------------------------------------
# Main environment files
.env
.env.local
.env.*.local
*.env
*.ini

# PHP Database & Mailer credentials (contains live Brevo SMTP & DB passwords)
includes/db.php
includes/mailer.php

# Generic config & secret files
config.php
config.local.php
credentials.json
secrets.json
*.key
*.pem
*.p12
*.pfx

# Explicitly track safe example templates
!includes/db.example.php
!includes/mailer.example.php
!.env.example

# ------------------------------------------------------------------------------
# 2. Database Dumps with Sensitive User & Session Data
# ------------------------------------------------------------------------------
# Ignore raw SQL dumps that contain live passwords, hashes, personal emails & tokens
database/canteen.sql
*.sql.bak
*.sql.gz
*.sql.tar.gz
*.dump
*.backup

# Explicitly track clean, sanitized schema template for repository setup
!database/schema.sql

# ------------------------------------------------------------------------------
# 3. Log Files & Server Runtime Artifacts
# ------------------------------------------------------------------------------
*.log
error_log
access_log
logs/
*.pid
*.seed

# ------------------------------------------------------------------------------
# 4. Dependency Directories (Composer / NPM)
# ------------------------------------------------------------------------------
vendor/
composer.phar
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 5. Operating System Cache & Metadata Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 6. IDE & Code Editor Files
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PhpStorm
.idea/
*.iws
*.iml

# NetBeans & Eclipse
nbproject/
.buildpath
.project
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 7. Temporary, Cache & Backup Files
# ------------------------------------------------------------------------------
tmp/
temp/
cache/
*.tmp
*.bak
*.swp
*.swo
